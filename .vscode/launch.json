{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MacOS",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/telemetry.app/Contents/MacOS/telemetry",
      "args": [],
      // "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/telemetry.app/Contents/MacOS/",
      // "preLaunchTask": "cmake-build", // Optional: a task to rebuild before debugging
      "externalConsole": true,        // To see the output in an external console
      "stopAtEntry": false,           // To stop at the beginning of main()
      "environment": []
    },
    {
      "name": "Debug Windows",
      "type": "cppvsdbg",                  // uses the Visual Studio debugger
      "request": "launch",
      "program": "${workspaceFolder}/build/telemetry.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/",  // working directory
      "environment": [],
      "console": "externalTerminal",       // or "integratedTerminal"
      "stopAtEntry": false
    }
  ]
}
